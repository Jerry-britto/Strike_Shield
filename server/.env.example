# Copy to .env inside server/ and fill in real values.
# Local dev only — on Render these go in the service's Environment dashboard.
# NEVER commit the real .env (root .gitignore covers it).

# Render injects PORT automatically; leave unset on the host, set 8000 locally.
PORT=8000

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster/DBNAME?retryWrites=true&w=majority
DB_NAME=your-db-name

# Rotate before first production use — treat existing dev values as exposed.
ACCESS_TOKEN=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d

# Firebase (server-side uploads). Must match the web config of your project.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APPID=
FIREBASE_MEASUREMENTID=

# Optional. Dev-only. Comma-separated list of browser origins allowed by CORS.
# Single-origin prod deploys do NOT need it (API serves the client itself).
# CLIENT_ORIGIN=http://localhost:5173
